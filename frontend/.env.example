# =============================================================================
# Modele d'environnement du frontend VOLO
# =============================================================================
# Copiez ce fichier en `.env.local` et renseignez la valeur reelle :
#
#     cp frontend/.env.example frontend/.env.local
#
# Deux regles a connaitre sur Vite :
#
#  1. Seules les variables prefixees VITE_ sont exposees au code. Une variable
#     sans ce prefixe est ignoree — elle ne sert donc a rien ici.
#
#  2. Ces variables sont figees AU MOMENT DU BUILD, pas au demarrage. En
#     production Docker, elles doivent donc arriver en build arg : voir
#     `args:` du service frontend dans docker-compose.yml. Les passer en
#     `environment:` n'aurait aucun effet.
# =============================================================================

# Cle PUBLIQUE Stripe (pk_...). Elle finit dans le bundle et sera visible par
# tout visiteur : c'est son role. Ne jamais mettre ici la cle secrete (sk_...),
# qui reste cote backend.
VITE_STRIPE_PUBLIC_KEY=pk_test_a_remplacer
