# define your env variables for the test env here
DATABASE_URL="mysql://root@127.0.0.1:3306/volo"
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# null:// en test, et SEULEMENT en test : les assertions d'email de Symfony
# passent par un ecouteur qui enregistre les messages envoyes, independamment
# du transport. On peut donc verifier qu'un mail est parti sans qu'aucun SMTP
# ne soit joignable. En dev, MAILER_DSN vise Mailpit a dessein (cf. .env).
MAILER_DSN=null://null
ADMIN_EMAIL=contact@volo.fr
MAILER_FROM=no-reply@volo.fr

STRIPE_SECRET_KEY=sk_test_fake
STRIPE_WEBHOOK_SECRET=whsec_test_secret

