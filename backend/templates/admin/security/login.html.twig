{# ==============================================================================
   Template : admin/security/login.html.twig
   ==============================================================================
   Objectif :
       Formulaire de connexion du back-office. Autonome (n'etend aucun layout
       existant) pour ne dependre d'aucune structure Twig deja en place.

   Points importants :
       - Le champ cache _csrf_token est obligatoire ici car security.yaml
         declare enable_csrf: true sur le firewall 'admin'. Sans ce champ,
         Symfony refuse la connexion avec une erreur CSRF invisible a l'oeil nu.
       - La mise en forme vit dans /admin-theme/volo-login.css et non dans un
         bloc <style> : la Content-Security-Policy du site interdit les styles
         inline (`default-src 'self'` sans `style-src 'unsafe-inline'`), la
         page s'affichait donc sans aucun style.
   ============================================================================== #}
<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Connexion — Administration VOLO</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/admin-theme/favicon.svg">
    <link rel="stylesheet" href="/admin-theme/volo-login.css">
</head>
<body>
    <div class="login-card">
        <div class="login-brand">
            <img src="/images/Vologo.webp" alt="VOLO">
        </div>
        <h1>Administration</h1>
        <p class="login-subtitle">Espace reserve aux administrateurs</p>

        {% if error %}
            <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <label for="username">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>

            <label for="password">Mot de passe</label>
            <input type="password" name="_password" id="password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Se connecter</button>
        </form>

        <a class="login-back" href="/">Retour au site</a>
    </div>
</body>
</html>
