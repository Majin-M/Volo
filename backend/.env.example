# =============================================================================
# Modele d'environnement du backend VOLO
# =============================================================================
# Copiez ce fichier en `.env.local` et renseignez les valeurs reelles :
#
#     cp backend/.env.example backend/.env.local
#
# `.env.local` n'est jamais versionne. Ne mettez JAMAIS de secret reel ici :
# ce fichier, lui, est dans le depot.
#
# Toutes les variables ci-dessous sont lues par l'application. Sans elles,
# le backend ne demarre pas ou echoue a la premiere requete concernee.
# =============================================================================

# --- Environnement -----------------------------------------------------------
# dev | prod | test
APP_ENV=dev
# Chaine aleatoire, propre a chaque installation.
# Generer : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=a_remplacer_par_une_chaine_aleatoire

# URL de base utilisee pour generer des liens hors contexte HTTP — commandes
# console, emails. Sans elle, le routeur ne sait pas quel hote employer et
# l'application refuse de demarrer (routing.yaml n'a pas de valeur par defaut).
# En production : l'URL publique du site.
DEFAULT_URI=http://localhost

# --- Base de donnees ---------------------------------------------------------
# ATTENTION : `serverVersion` indique a Doctrine quelle plateforme SQL cibler,
# il ne choisit pas le serveur. Le declarer faux fait generer du SQL qu'un
# serveur different peut refuser (cf. docs/TECHNOLOGIES.md §2).
#
#   XAMPP (MariaDB)  : serverVersion=mariadb-10.4.32
#   Docker (MySQL 8) : serverVersion=8.0
DATABASE_URL="mysql://volo_user:volo_password@127.0.0.1:3306/volo?serverVersion=8.0&charset=utf8mb4"

# --- Messenger ---------------------------------------------------------------
# Aucun worker n'est en place : les envois restent synchrones.
MESSENGER_TRANSPORT_DSN=sync://

# --- Emails ------------------------------------------------------------------
# En developpement, Mailpit capture tout : http://localhost:8025
MAILER_DSN=smtp://localhost:1025
# Destinataire des notifications du formulaire de contact.
ADMIN_EMAIL=admin@volo.fr
# Expediteur des emails sortants (confirmation de commande, bienvenue).
MAILER_FROM=noreply@volo.fr

# --- Authentification JWT ----------------------------------------------------
# Generer la paire de cles :
#     php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=a_remplacer_par_une_passphrase
# Duree de vie du jeton, en secondes.
# Doit rester coherente avec `token_ttl` (lexik_jwt_authentication.yaml)
# et AuthController::COOKIE_TTL.
JWT_TOKEN_TTL=3600

# --- CORS --------------------------------------------------------------------
# Le proxy Vite ramenant tout a une origine unique, cette valeur ne sert
# qu'aux appels hors proxy.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# --- Stripe ------------------------------------------------------------------
# Cle SECRETE : backend uniquement, ne doit jamais atteindre le navigateur.
STRIPE_SECRET_KEY=sk_test_a_remplacer
# Cle PUBLIQUE : finit dans le bundle frontend, donc visible. C'est normal.
STRIPE_PUBLIC_KEY=pk_test_a_remplacer
# Signature des webhooks. En local : `stripe listen` affiche la valeur.
STRIPE_WEBHOOK_SECRET=whsec_a_remplacer
