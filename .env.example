# =============================================================================
# Variables d'environnement Docker Compose — VOLO
# =============================================================================
# Copier ce fichier en .env a la racine du projet, PUIS le remplir :
#   cp .env.example .env
#
# Les secrets ci-dessous sont VIDES a dessein. docker-compose.yml les declare
# obligatoires : tant qu'ils ne sont pas renseignes, `docker compose` refuse
# de demarrer et nomme la variable manquante. C'est voulu — l'ancienne version
# de ce fichier fournissait des valeurs qui fonctionnaient, et une production
# pouvait demarrer avec des secrets publies dans le depot.
#
# Generer une valeur aleatoire :
#   openssl rand -hex 24
#   (ou : php -r "echo bin2hex(random_bytes(24));")
#
# N'utilisez QUE des caracteres hexadecimaux pour les mots de passe de base :
# ils sont inseres dans DATABASE_URL, et un @ : / ou # casserait l'URL.
# =============================================================================

# --- Uniquement sur un SERVEUR ------------------------------------------------
# Ignore docker-compose.override.yml (Mailpit et outils de dev). Decommenter
# sur le serveur, laisser commente sur le poste de developpement.
# COMPOSE_FILE=docker-compose.yml

# --- Symfony -----------------------------------------------------------------
APP_SECRET=
# URL publique du site. Dev : http://localhost — Production : https://votre-domaine
DEFAULT_URI=http://localhost

# --- Taches planifiees ------------------------------------------------------
# Intervalle, en secondes, entre deux balayages des commandes abandonnees
# (service scheduler). Facultatif : 900 par defaut.
# SWEEP_INTERVAL_SECONDS=900

# --- Base de donnees ---------------------------------------------------------
# Ces valeurs ne sont appliquees qu'a la PREMIERE creation du volume db_data.
# Les changer ensuite ne modifie pas les comptes MySQL existants.
MYSQL_DATABASE=volo
MYSQL_USER=volo_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- JWT ---------------------------------------------------------------------
JWT_PASSPHRASE=

# --- Emails ------------------------------------------------------------------
# Dev : Mailpit (docker-compose.override.yml), interface sur http://localhost:8025
# Production : le DSN SMTP de votre fournisseur, par exemple
#   smtp://UTILISATEUR:MOT_DE_PASSE@smtp-relay.brevo.com:587
# ATTENTION : laisser smtp://mailer:1025 en production ferait disparaitre tous
# les emails — ce service n'existe pas sur le serveur.
MAILER_DSN=smtp://mailer:1025
ADMIN_EMAIL=contact@volo.fr
MAILER_FROM=no-reply@volo.fr

# --- CORS --------------------------------------------------------------------
# Production : restreindre au domaine reel, ex. '^https://votre-domaine$'
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# --- Stripe ------------------------------------------------------------------
# Dev : cles de TEST (sk_test_..., pk_test_...). Production : cles live.
# La cle publique est figee dans le bundle frontend AU BUILD : la modifier
# impose de reconstruire l'image frontend.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
