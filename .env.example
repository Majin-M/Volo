# =============================================================================
# Variables d'environnement Docker Compose — VOLO
# =============================================================================
# Copier ce fichier en .env a la racine du projet :
#   cp .env.example .env
#
# Les valeurs par defaut (entre ${VAR:-defaut}) suffisent pour le developpement.
# En production, remplacer TOUTES les valeurs marquees "a changer".
# =============================================================================

# --- Symfony ---
APP_SECRET=change-me-in-production        # a changer : openssl rand -hex 16

# --- Base de donnees ---
MYSQL_ROOT_PASSWORD=root                  # a changer en production

# --- JWT ---
JWT_PASSPHRASE=VoLoJwT2026!              # a changer en production

# --- Emails ---
ADMIN_EMAIL=contact@volo.fr
MAILER_FROM=no-reply@volo.fr

# --- CORS ---
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# --- Stripe ---
STRIPE_SECRET_KEY=fausse_valeur           # a changer : sk_live_...
STRIPE_PUBLIC_KEY=fausse_valeur           # a changer : pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_placeholder   # a changer : whsec_...
