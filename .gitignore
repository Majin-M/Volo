# ==============================================================================
# Racine du monorepo VOLO — couvre backend (Symfony) et frontend (Vite/React)
# ==============================================================================

# --- Secrets (jamais commités, quel que soit le dossier) ---
# Ignore TOUT fichier .env ou .env.xxx, ou qu'il se trouve dans le repo.
# Le pattern precedent (*.local uniquement) laissait passer .env.dev, .env.prod, etc.
.env
.env.*
!.env.example
!*/.env.example
# Exception : .env.test ne contient que des valeurs de test (base locale,
# DSN null, cles Stripe factices). Il doit etre versionne, sinon la CI n'a
# aucune configuration pour executer la suite de tests. Les vrais secrets
# vivent dans .env.local, toujours ignore.
!*/.env.test

###> symfony/framework-bundle ###
backend/var/
backend/vendor/
backend/public/bundles/
backend/config/secrets/prod/prod.decrypt.private.php
###< symfony/framework-bundle ###

###> lexik/jwt-authentication-bundle ###
backend/config/jwt/*.pem
###< lexik/jwt-authentication-bundle ###

###> phpunit/phpunit ###
backend/phpunit.xml
backend/.phpunit.cache/
###< phpunit/phpunit ###

###> symfony/asset-mapper ###
backend/public/assets/
backend/assets/vendor/
###< symfony/asset-mapper ###

# --- Frontend (Vite / Node) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Sauvegardes BDD ---
backups/

# --- Editeurs / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db